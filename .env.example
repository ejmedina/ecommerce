# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ============================================
# AUTH
# ============================================
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# MERCADO PAGO
# ============================================
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxx"
MERCADOPAGO_WEBHOOK_SECRET="your-webhook-secret"

# ============================================
# RESEND (Email)
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Tienda <pedidos@tudominio.com>"

# ============================================
# UPLOADTHING (Images)
# ============================================
UPLOADTHING_SECRET="sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
UPLOADTHING_APP_ID="xxxxxxxxxxxxx"

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mi Tienda"
HOME_MODE="storefront"
HOME_FLAVOR=""
CONTACT_FORM_TO="comercial@pgi.com.ar"

# ============================================
# ANALYTICS (server-only)
# Used to encrypt each store's Meta Conversions API token at rest.
# Generate it with: openssl rand -base64 32
# Never use a NEXT_PUBLIC_ variable for this value.
# ============================================
ANALYTICS_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"
META_GRAPH_API_VERSION="v23.0"
